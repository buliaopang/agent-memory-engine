          "title": "Summary"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "vector_status": {
          "default": "pending",
          "title": "Vector Status",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        }
