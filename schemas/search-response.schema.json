    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/SearchResult"
      },
      "title": "Results",
      "type": "array"
    },
    "retrieval_mode": {
      "enum": [
        "hybrid",
        "lexical_graph"
      ],
      "title": "Retrieval Mode",
      "type": "string"
    },
    "total_candidates": {
      "title": "Total Candidates",
      "type": "integer"
    }
  },
  "required": [
    "query_id",
    "retrieval_mode",
    "degraded_reason",
    "total_candidates",
    "results"
  ],
  "title": "SearchResponse",
  "type": "object"
}
