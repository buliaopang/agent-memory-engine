{
  "$defs": {
    "GraphContextItem": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "out",
            "in"
          ],
          "title": "Direction",
          "type": "string"
        },
        "kind": {
          "enum": [
            "edge",
            "relation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "link_type": {
          "title": "Link Type",
          "type": "string"
        },
        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "kind",
        "link_type",
        "direction"
      ],
      "title": "GraphContextItem",
      "type": "object"
    },
    "Layer": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ],
      "title": "Layer",
      "type": "string"
    },
    "MemoryRead": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "current_version": {
          "title": "Current Version",
          "type": "integer"
        },
        "importance": {
          "title": "Importance",
          "type": "number"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        },
        "memory_type": {
          "$ref": "#/$defs/MemoryType"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "reference_ids": {
          "items": {
            "type": "string"
          },
          "title": "Reference Ids",
          "type": "array"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "scope_type": {
          "$ref": "#/$defs/ScopeType"
