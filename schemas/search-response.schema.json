      "required": [
        "memory_id",
        "current_version",
        "version_id",
        "content",
        "summary",
        "content_hash",
        "memory_type",
        "layer",
        "scope_type",
        "scope_id",
        "created_by",
        "created_at",
        "updated_at",
        "importance",
        "confidence",
        "status",
        "tags",
        "sources",
        "parent_ids",
        "reference_ids",
        "metadata"
