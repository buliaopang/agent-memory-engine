      "type": "object"
    },
    "MemoryStatus": {
      "enum": [
        "candidate",
        "active",
        "conflicted",
        "superseded",
        "archived",
        "rejected"
      ],
      "title": "MemoryStatus",
      "type": "string"
    },
    "MemoryType": {
      "enum": [
        "working",
        "episodic",
        "semantic",
        "procedural"
      ],
      "title": "MemoryType",
      "type": "string"
    },
    "ScopeType": {
      "enum": [
        "private",
        "project",
        "shared"
      ],
      "title": "ScopeType",
      "type": "string"
    },
    "ScoreBreakdown": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "freshness": {
          "title": "Freshness",
          "type": "number"
        },
        "graph": {
          "title": "Graph",
          "type": "number"
        },
        "importance": {
          "title": "Importance",
          "type": "number"
        },
        "keyword": {
          "title": "Keyword",
          "type": "number"
        },
        "vector": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vector"
        },
        "vector_used": {
          "title": "Vector Used",
          "type": "boolean"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "vector",
        "keyword",
        "graph",
        "importance",
        "confidence",
        "freshness",
        "weights",
        "vector_used"
      ],
      "title": "ScoreBreakdown",
      "type": "object"
    },
    "SearchResult": {
      "additionalProperties": false,
      "properties": {
        "conflicted": {
          "title": "Conflicted",
          "type": "boolean"
        },
        "graph_context": {
          "items": {
            "$ref": "#/$defs/GraphContextItem"
          },
          "title": "Graph Context",
          "type": "array"
        },
        "matched_terms": {
          "title": "Matched Terms",
          "type": "integer"
        },
        "memory": {
          "$ref": "#/$defs/MemoryRead"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "score_breakdown": {
          "$ref": "#/$defs/ScoreBreakdown"
        }
