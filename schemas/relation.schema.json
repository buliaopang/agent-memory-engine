{
  "$defs": {
    "ActorType": {
      "enum": [
        "user",
        "agent",
        "system"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "LinkStatus": {
      "description": "Lifecycle of structural edges and semantic relations (ADR-006).",
      "enum": [
        "active",
        "revoked"
      ],
      "title": "LinkStatus",
      "type": "string"
    },
    "RelationType": {
      "description": "Semantic relation types (NOT cycle-checked). ADR-007/008.",
      "enum": [
        "CONTRADICTS",
        "SUPPORTS",
        "RELATED_TO"
      ],
      "title": "RelationType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created": {
      "default": false,
      "title": "Created",
      "type": "boolean"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "directed": {
      "title": "Directed",
      "type": "boolean"
    },
    "from_memory_id": {
      "title": "From Memory Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "relation_id": {
      "title": "Relation Id",
      "type": "string"
    },
    "relation_type": {
      "$ref": "#/$defs/RelationType"
    },
    "review_notice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Notice"
    },
    "revoked_actor_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorType"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revoked At"
    },
    "revoked_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revoked By"
    },
    "revoked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revoked Reason"
    },
    "status": {
      "$ref": "#/$defs/LinkStatus"
    },
    "to_memory_id": {
      "title": "To Memory Id",
      "type": "string"
    }
  },
  "required": [
    "relation_id",
    "relation_type",
    "directed",
    "from_memory_id",
    "to_memory_id",
    "status",
    "created_by",
    "created_at",
    "metadata",
    "revoked_at",
    "revoked_by",
    "revoked_actor_type",
    "revoked_reason"
  ],
  "title": "RelationRead",
  "type": "object"
}
